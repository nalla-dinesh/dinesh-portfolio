{
  "name": "dinesh-portfolio-vercel",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "check:repo": "node scripts/validate-repo.mjs",
    "check": "npm run check:repo && npm run typecheck",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lenis": "^1.3.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~7.0.2",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0"
  },
  "description": "Dinesh Nalla \u2014 3D investigation-room portfolio, Vercel-ready via GitHub.",
  "author": "Dinesh Nalla <nalladinesh53@gmail.com> (https://github.com/nalla-dinesh)",
  "license": "MIT",
